<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ButtonBox.App</RootNamespace>
    <AssemblyName>ButtonBox.App</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <ProjectReference Include="..\Core\ButtonBox.Core.csproj" />
    <ProjectReference Include="..\Discovery\ButtonBox.Discovery.csproj" />
    <ProjectReference Include="..\Security\ButtonBox.Security.csproj" />
    <ProjectReference Include="..\Simulator\ButtonBox.Simulator.csproj" />
  </ItemGroup>

  <!-- Phase 3 demo (decisions §3, §7): read-only profile, catalog and images, embedded until the Phase 4 profile store and asset library exist. -->
  <PropertyGroup>
    <AssetSourceDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\assets\source'))</AssetSourceDir>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Demo\demo.profile.json" LogicalName="demo/demo.profile.json" />
    <EmbeddedResource Include="Demo\ets2-demo.catalog.json" LogicalName="demo/ets2-demo.catalog.json" />
    <EmbeddedResource Include="$(AssetSourceDir)\rotary\base.png" LogicalName="demo/rotary-base.png" />
    <EmbeddedResource Include="$(AssetSourceDir)\rotary\knob.png" LogicalName="demo/rotary-knob.png" />
    <EmbeddedResource Include="$(AssetSourceDir)\engine-button\body.png" LogicalName="demo/engine-body.png" />
  </ItemGroup>

  <PropertyGroup>
    <LogoPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\assets\source\logo\logo.png'))</LogoPath>
    <TemplatesDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\templates'))</TemplatesDir>
    <WebAppsDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\web\apps'))</WebAppsDir>
  </PropertyGroup>

  <Target Name="CheckLogo" BeforeTargets="BeforeBuild;AssignTargetPaths">
    <Error Condition="!Exists('$(LogoPath)')" Text="Tray icon source is missing: $(LogoPath)" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="$(LogoPath)" LogicalName="tray-logo.png" />
    <ClientDist Include="$(WebAppsDir)\client\dist\**" Condition="Exists('$(WebAppsDir)\client\dist')" />
    <EditorDist Include="$(WebAppsDir)\editor\dist\**" Condition="Exists('$(WebAppsDir)\editor\dist')" />
    <None Include="@(ClientDist)" Link="wwwroot\client\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="@(EditorDist)" Link="wwwroot\editor\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Device templates that ship with the app (decisions §6). -->
    <ShippedTemplate Include="$(TemplatesDir)\*.json" />
    <None Include="@(ShippedTemplate)" Link="templates\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
