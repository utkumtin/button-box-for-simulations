{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "editor-api.schema.json",
  "title": "EditorApi",
  "description": "Bodies of the loopback-only editor API (/editor/api/...).",
  "definitions": {
    "deviceName": {
      "title": "DeviceName",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "deviceInfo": {
      "title": "DeviceInfo",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "templateId", "connected", "screenMismatch"],
      "properties": {
        "id": { "$ref": "common.schema.json#/definitions/id" },
        "name": { "$ref": "#/definitions/deviceName" },
        "templateId": { "$ref": "common.schema.json#/definitions/id" },
        "connected": { "type": "boolean" },
        "screenMismatch": {
          "description": "The screen the phone reported at pairing differs from its template.",
          "type": "boolean"
        }
      }
    },
    "deviceList": {
      "title": "DeviceList",
      "type": "object",
      "additionalProperties": false,
      "required": ["devices"],
      "properties": {
        "devices": { "type": "array", "maxItems": 64, "items": { "$ref": "#/definitions/deviceInfo" } }
      }
    },
    "renameDeviceRequest": {
      "title": "RenameDeviceRequest",
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/definitions/deviceName" }
      }
    },
    "templateList": {
      "title": "TemplateList",
      "type": "object",
      "additionalProperties": false,
      "required": ["templates"],
      "properties": {
        "templates": { "type": "array", "maxItems": 256, "items": { "$ref": "template.schema.json" } }
      }
    },
    "startPairingRequest": {
      "title": "StartPairingRequest",
      "description": "templateId absent: the device is not listed and gets a generic template.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "templateId": { "$ref": "common.schema.json#/definitions/id" }
      }
    },
    "pairingStatus": {
      "title": "PairingStatus",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "title": "PairingState",
          "type": "string",
          "enum": ["closed", "caDownload", "codeShown", "paired", "failed"]
        },
        "address": {
          "description": "Plain-HTTP address of the certificate page, with explicit scheme (and port when not 80).",
          "type": "string",
          "maxLength": 128
        },
        "caFingerprint": {
          "description": "SHA-256 of the CA certificate, 64 upper-case hex digits.",
          "type": "string",
          "pattern": "^[0-9A-F]{64}$"
        },
        "code": { "type": "string", "pattern": "^[0-9]{6}$" },
        "codeExpiresAt": { "type": "string", "format": "date-time" },
        "attemptsLeft": { "type": "integer", "minimum": 0, "maximum": 5 },
        "deviceId": { "$ref": "common.schema.json#/definitions/id" },
        "screenMismatch": { "type": "boolean" },
        "failure": {
          "title": "PairingFailure",
          "type": "string",
          "enum": ["codeExpired", "codeBurned", "portInUse"]
        }
      }
    },
    "problemList": {
      "title": "ProblemList",
      "description": "Why a profile or an image was refused, as human-readable sentences.",
      "type": "object",
      "additionalProperties": false,
      "required": ["problems"],
      "properties": {
        "problems": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "maxLength": 300 } }
      }
    },
    "catalogList": {
      "title": "CatalogList",
      "description": "The catalogs that ship with the app. A game without a catalog cannot be chosen yet.",
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogs"],
      "properties": {
        "catalogs": { "type": "array", "maxItems": 8, "items": { "$ref": "catalog.schema.json" } }
      }
    },
    "profileSummary": {
      "title": "ProfileSummary",
      "description": "damaged: the file cannot be read or does not validate; name and game are then absent.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "damaged"],
      "properties": {
        "id": { "$ref": "common.schema.json#/definitions/id" },
        "damaged": { "type": "boolean" },
        "name": { "$ref": "common.schema.json#/definitions/profileName" },
        "game": { "$ref": "common.schema.json#/definitions/game" }
      }
    },
    "profileList": {
      "title": "ProfileList",
      "description": "activeId absent: no active profile.",
      "type": "object",
      "additionalProperties": false,
      "required": ["profiles"],
      "properties": {
        "activeId": { "$ref": "common.schema.json#/definitions/id" },
        "profiles": { "type": "array", "maxItems": 256, "items": { "$ref": "#/definitions/profileSummary" } }
      }
    },
    "createProfileRequest": {
      "title": "CreateProfileRequest",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "game"],
      "properties": {
        "name": { "$ref": "common.schema.json#/definitions/profileName" },
        "game": { "$ref": "common.schema.json#/definitions/game" }
      }
    },
    "assetInfo": {
      "title": "AssetInfo",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "size", "bytes", "usedBy"],
      "properties": {
        "id": { "$ref": "common.schema.json#/definitions/assetId" },
        "type": {
          "title": "AssetType",
          "type": "string",
          "enum": ["png", "webp"]
        },
        "size": { "description": "Width and height in px (assets are square).", "type": "integer", "minimum": 512, "maximum": 2048 },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 4194304 },
        "usedBy": {
          "description": "Ids of the profiles that reference the asset.",
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "common.schema.json#/definitions/id" }
        }
      }
    },
    "assetList": {
      "title": "AssetList",
      "type": "object",
      "additionalProperties": false,
      "required": ["assets"],
      "properties": {
        "assets": { "type": "array", "maxItems": 1024, "items": { "$ref": "#/definitions/assetInfo" } }
      }
    },
    "telemetryFieldValue": {
      "title": "TelemetryFieldValue",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "$ref": "common.schema.json#/definitions/telemetryField" },
        "value": { "type": "integer" }
      }
    },
    "telemetryView": {
      "title": "TelemetryView",
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "gameListening", "fields"],
      "properties": {
        "available": { "type": "boolean" },
        "gameListening": { "type": "boolean" },
        "fields": { "type": "array", "maxItems": 512, "items": { "$ref": "#/definitions/telemetryFieldValue" } }
      }
    },
    "testPressRequest": {
      "title": "TestPressRequest",
      "description": "Test mode: a catalog action of the active profile's game, sent even when the game is not listening.",
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId"],
      "properties": {
        "actionId": { "$ref": "common.schema.json#/definitions/id" }
      }
    },
    "settingsStatus": {
      "title": "SettingsStatus",
      "type": "object",
      "additionalProperties": false,
      "required": ["certificate", "firewall", "scsPlugin"],
      "properties": {
        "scsPlugin": { "$ref": "#/definitions/scsPluginStatus" },
        "certificate": {
          "title": "CertificateStatus",
          "description": "fingerprint: SHA-256 of the CA certificate, 64 upper-case hex digits; absent when the CA is unavailable.",
          "type": "object",
          "additionalProperties": false,
          "required": ["available"],
          "properties": {
            "available": { "type": "boolean" },
            "fingerprint": { "type": "string", "pattern": "^[0-9A-F]{64}$" }
          }
        },
        "firewall": {
          "title": "FirewallState",
          "type": "string",
          "enum": ["present", "missing", "unknown"]
        }
      }
    },
    "scsPluginStatus": {
      "title": "ScsPluginStatus",
      "description": "included: the plugin DLL ships with this build (decisions §12). games: ETS2 and ATS, always both.",
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "games"],
      "properties": {
        "included": { "type": "boolean" },
        "games": { "type": "array", "maxItems": 2, "items": { "$ref": "#/definitions/scsGameStatus" } }
      }
    },
    "scsGame": {
      "title": "ScsGame",
      "type": "string",
      "enum": ["ets2", "ats"]
    },
    "scsGameStatus": {
      "title": "ScsGameStatus",
      "description": "installDir: absent when the game is not found. connected: this game's plugin is connected to the host now.",
      "type": "object",
      "additionalProperties": false,
      "required": ["game", "state", "connected"],
      "properties": {
        "game": { "$ref": "#/definitions/scsGame" },
        "state": {
          "title": "ScsPluginState",
          "type": "string",
          "enum": ["gameNotFound", "notInstalled", "upToDate", "updateAvailable"]
        },
        "installDir": { "type": "string", "minLength": 1, "maxLength": 260 },
        "connected": { "type": "boolean" }
      }
    },
    "scsInstallRequest": {
      "title": "ScsInstallRequest",
      "type": "object",
      "additionalProperties": false,
      "required": ["game"],
      "properties": {
        "game": { "$ref": "#/definitions/scsGame" }
      }
    },
    "regenerateCaRequest": {
      "title": "RegenerateCaRequest",
      "description": "The user typed the confirmation word.",
      "type": "object",
      "additionalProperties": false,
      "required": ["confirm"],
      "properties": {
        "confirm": { "type": "string", "const": "REGENERATE" }
      }
    },
    "hostStatus": {
      "title": "HostStatus",
      "type": "object",
      "additionalProperties": false,
      "required": ["mdnsName", "lanServer", "addresses"],
      "properties": {
        "mdnsName": { "type": "string", "maxLength": 63 },
        "lanServer": {
          "title": "LanServerState",
          "type": "string",
          "enum": ["starting", "running", "portInUse", "noLanAddress", "caUnavailable", "devicesUnavailable", "startFailed"]
        },
        "portOwner": {
          "description": "Process holding TCP 443 when lanServer is portInUse, if known.",
          "type": "string",
          "maxLength": 260
        },
        "addresses": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 15 } }
      }
    }
  }
}
