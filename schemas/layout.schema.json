{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "layout.schema.json",
  "title": "Layout",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "templateId",
    "grid",
    "widgets"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "templateId": {
      "$ref": "common.schema.json#/definitions/id"
    },
    "grid": {
      "$ref": "#/definitions/grid"
    },
    "widgets": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/definitions/widget"
      }
    }
  },
  "definitions": {
    "grid": {
      "title": "Grid",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columns",
        "rows"
      ],
      "properties": {
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    },
    "widget": {
      "title": "Widget",
      "oneOf": [
        {
          "$ref": "#/definitions/toggleWidget"
        },
        {
          "$ref": "#/definitions/encoderWidget"
        },
        {
          "$ref": "#/definitions/switchWidget"
        },
        {
          "$ref": "#/definitions/dualActionWidget"
        }
      ]
    },
    "widgetBase": {
      "title": "WidgetBase",
      "type": "object",
      "discriminator": {
        "propertyName": "type",
        "mapping": {
          "toggle": "#/definitions/toggleWidget",
          "encoder": "#/definitions/encoderWidget",
          "switch": "#/definitions/switchWidget",
          "dualAction": "#/definitions/dualActionWidget"
        }
      },
      "required": [
        "id",
        "type",
        "cell"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "type": {
          "type": "string",
          "maxLength": 32
        },
        "cell": {
          "$ref": "common.schema.json#/definitions/gridCell"
        },
        "label": {
          "type": "string",
          "maxLength": 32
        },
        "longPressGuard": {
          "type": "boolean"
        }
      }
    },
    "toggleWidget": {
      "title": "ToggleWidget",
      "allOf": [
        {
          "$ref": "#/definitions/widgetBase"
        },
        {
          "type": "object",
          "required": [
            "type",
            "action"
          ],
          "properties": {
            "type": {
              "const": "toggle"
            },
            "action": {
              "$ref": "common.schema.json#/definitions/id"
            }
          }
        }
      ]
    },
    "encoderWidget": {
      "title": "EncoderWidget",
      "allOf": [
        {
          "$ref": "#/definitions/widgetBase"
        },
        {
          "type": "object",
          "required": [
            "type",
            "minus",
            "plus"
          ],
          "properties": {
            "type": {
              "const": "encoder"
            },
            "minus": {
              "$ref": "common.schema.json#/definitions/id"
            },
            "plus": {
              "$ref": "common.schema.json#/definitions/id"
            }
          }
        }
      ]
    },
    "switchWidget": {
      "title": "SwitchWidget",
      "allOf": [
        {
          "$ref": "#/definitions/widgetBase"
        },
        {
          "type": "object",
          "required": [
            "type",
            "positions"
          ],
          "properties": {
            "type": {
              "const": "switch"
            },
            "positions": {
              "type": "array",
              "minItems": 2,
              "maxItems": 8,
              "items": {
                "$ref": "#/definitions/switchPosition"
              }
            },
            "cycle": {
              "$ref": "common.schema.json#/definitions/id"
            }
          }
        }
      ]
    },
    "switchPosition": {
      "title": "SwitchPosition",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "angle"
      ],
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 32
        },
        "angle": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "action": {
          "$ref": "common.schema.json#/definitions/id"
        }
      }
    },
    "dualActionWidget": {
      "title": "DualActionWidget",
      "allOf": [
        {
          "$ref": "#/definitions/widgetBase"
        },
        {
          "type": "object",
          "required": [
            "type",
            "holdMode"
          ],
          "properties": {
            "type": {
              "const": "dualAction"
            },
            "tap": {
              "$ref": "common.schema.json#/definitions/id"
            },
            "hold": {
              "$ref": "common.schema.json#/definitions/id"
            },
            "holdMode": {
              "type": "string",
              "enum": [
                "fire",
                "starterTakeover"
              ]
            }
          }
        }
      ]
    }
  }
}
