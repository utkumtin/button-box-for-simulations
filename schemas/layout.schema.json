{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "layout.schema.json",
  "title": "Layout",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "templateId",
    "grid",
    "widgets"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "templateId": {
      "$ref": "common.schema.json#/definitions/id"
    },
    "grid": {
      "$ref": "#/definitions/grid"
    },
    "widgets": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/definitions/widget"
      }
    }
  },
  "definitions": {
    "grid": {
      "title": "Grid",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columns",
        "rows"
      ],
      "properties": {
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    },
    "widget": {
      "title": "Widget",
      "oneOf": [
        {
          "$ref": "#/definitions/toggleWidget"
        },
        {
          "$ref": "#/definitions/encoderWidget"
        },
        {
          "$ref": "#/definitions/switchWidget"
        },
        {
          "$ref": "#/definitions/dualActionWidget"
        }
      ]
    },
    "widgetBase": {
      "title": "WidgetBase",
      "type": "object",
      "discriminator": {
        "propertyName": "type",
        "mapping": {
          "toggle": "#/definitions/toggleWidget",
          "encoder": "#/definitions/encoderWidget",
          "switch": "#/definitions/switchWidget",
          "dualAction": "#/definitions/dualActionWidget"
        }
      },
      "required": [
        "id",
        "type",
        "cell"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "type": {
          "type": "string",
          "maxLength": 32
        },
        "cell": {
          "$ref": "common.schema.json#/definitions/gridCell"
        },
        "label": {
          "type": "string",
          "maxLength": 32
        },
        "longPressGuard": {
          "type": "boolean"
        },
        "state": {
          "$ref": "#/definitions/stateBinding"
        }
      }
    },
    "toggleWidget": {
      "title": "ToggleWidget",
      "allOf": [
        {
          "$ref": "#/definitions/widgetBase"
        },
        {
          "type": "object",
          "required": [
            "type",
            "action"
          ],
          "properties": {
            "type": {
              "const": "toggle"
            },
            "action": {
              "$ref": "common.schema.json#/definitions/id"
            },
            "look": {
              "$ref": "#/definitions/look"
            }
          }
        }
      ]
    },
    "encoderWidget": {
      "title": "EncoderWidget",
      "allOf": [
        {
          "$ref": "#/definitions/widgetBase"
        },
        {
          "type": "object",
          "required": [
            "type",
            "minus",
            "plus"
          ],
          "properties": {
            "type": {
              "const": "encoder"
            },
            "minus": {
              "$ref": "common.schema.json#/definitions/id"
            },
            "plus": {
              "$ref": "common.schema.json#/definitions/id"
            }
          }
        }
      ]
    },
    "switchWidget": {
      "title": "SwitchWidget",
      "allOf": [
        {
          "$ref": "#/definitions/widgetBase"
        },
        {
          "type": "object",
          "required": [
            "type",
            "positions"
          ],
          "properties": {
            "type": {
              "const": "switch"
            },
            "positions": {
              "type": "array",
              "minItems": 2,
              "maxItems": 8,
              "items": {
                "$ref": "#/definitions/switchPosition"
              }
            },
            "cycle": {
              "$ref": "common.schema.json#/definitions/id"
            },
            "rotary": {
              "$ref": "#/definitions/rotary"
            }
          }
        }
      ]
    },
    "switchPosition": {
      "title": "SwitchPosition",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "angle"
      ],
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 32
        },
        "angle": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "action": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "icon": {
          "$ref": "common.schema.json#/definitions/id"
        }
      }
    },
    "dualActionWidget": {
      "title": "DualActionWidget",
      "allOf": [
        {
          "$ref": "#/definitions/widgetBase"
        },
        {
          "type": "object",
          "required": [
            "type",
            "holdMode"
          ],
          "properties": {
            "type": {
              "const": "dualAction"
            },
            "tap": {
              "$ref": "common.schema.json#/definitions/id"
            },
            "hold": {
              "$ref": "common.schema.json#/definitions/id"
            },
            "holdMode": {
              "type": "string",
              "enum": [
                "fire",
                "starterTakeover"
              ]
            },
            "look": {
              "$ref": "#/definitions/look"
            }
          }
        }
      ]
    },
    "stateBinding": {
      "title": "StateBinding",
      "description": "Telemetry fields shown by the widget: non-zero means lit / LED green.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lit": {
          "$ref": "common.schema.json#/definitions/telemetryField"
        },
        "led": {
          "$ref": "common.schema.json#/definitions/telemetryField"
        }
      }
    },
    "look": {
      "title": "Look",
      "oneOf": [
        {
          "$ref": "#/definitions/iconLook"
        },
        {
          "$ref": "#/definitions/imagesLook"
        }
      ]
    },
    "lookBase": {
      "title": "LookBase",
      "type": "object",
      "discriminator": {
        "propertyName": "mode",
        "mapping": {
          "icon": "#/definitions/iconLook",
          "images": "#/definitions/imagesLook"
        }
      },
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "maxLength": 16
        }
      }
    },
    "iconLook": {
      "title": "IconLook",
      "description": "Tinted MDI icon; the key is the MDI name in the widget package's icon registry.",
      "allOf": [
        {
          "$ref": "#/definitions/lookBase"
        },
        {
          "type": "object",
          "required": [
            "mode",
            "icon"
          ],
          "properties": {
            "mode": {
              "const": "icon"
            },
            "icon": {
              "$ref": "common.schema.json#/definitions/id"
            }
          }
        }
      ]
    },
    "imagesLook": {
      "title": "ImagesLook",
      "description": "One image; the lit state is produced in code unless an 'on' image is given.",
      "allOf": [
        {
          "$ref": "#/definitions/lookBase"
        },
        {
          "type": "object",
          "required": [
            "mode",
            "image"
          ],
          "properties": {
            "mode": {
              "const": "images"
            },
            "image": {
              "$ref": "common.schema.json#/definitions/assetId"
            },
            "on": {
              "$ref": "common.schema.json#/definitions/assetId"
            }
          }
        }
      ]
    },
    "rotary": {
      "title": "Rotary",
      "description": "Rotary layers. A missing layer is drawn in code.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base": {
          "$ref": "#/definitions/rotaryLayer"
        },
        "knob": {
          "$ref": "#/definitions/rotaryLayer"
        },
        "highlight": {
          "$ref": "#/definitions/rotaryLayer"
        }
      }
    },
    "rotaryLayer": {
      "title": "RotaryLayer",
      "description": "An image layer with calibration: scale of the widget's square, centre offset as a fraction of it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset"
      ],
      "properties": {
        "asset": {
          "$ref": "common.schema.json#/definitions/assetId"
        },
        "scale": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 2
        },
        "offsetX": {
          "type": "number",
          "minimum": -0.5,
          "maximum": 0.5
        },
        "offsetY": {
          "type": "number",
          "minimum": -0.5,
          "maximum": 0.5
        }
      }
    }
  }
}
