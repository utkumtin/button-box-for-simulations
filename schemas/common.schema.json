{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "common.schema.json",
  "title": "Common",
  "definitions": {
    "id": {
      "title": "Id",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "maxLength": 64
    },
    "game": {
      "title": "Game",
      "type": "string",
      "enum": ["ac1", "acc", "acevo", "ets2", "ats"]
    },
    "safeArea": {
      "title": "SafeArea",
      "type": "object",
      "additionalProperties": false,
      "required": ["top", "right", "bottom", "left"],
      "properties": {
        "top": { "type": "number", "minimum": 0, "maximum": 512 },
        "right": { "type": "number", "minimum": 0, "maximum": 512 },
        "bottom": { "type": "number", "minimum": 0, "maximum": 512 },
        "left": { "type": "number", "minimum": 0, "maximum": 512 }
      }
    },
    "screenInfo": {
      "title": "ScreenInfo",
      "description": "Landscape viewport in CSS px, its safe-area insets and the device pixel ratio.",
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "safeArea", "pixelRatio"],
      "properties": {
        "width": { "type": "integer", "minimum": 200, "maximum": 4096 },
        "height": { "type": "integer", "minimum": 200, "maximum": 4096 },
        "safeArea": { "$ref": "#/definitions/safeArea" },
        "pixelRatio": { "type": "number", "minimum": 1, "maximum": 4 }
      }
    },
    "gridCell": {
      "title": "GridCell",
      "type": "object",
      "additionalProperties": false,
      "required": ["col", "row", "colSpan", "rowSpan"],
      "properties": {
        "col": { "type": "integer", "minimum": 0, "maximum": 64 },
        "row": { "type": "integer", "minimum": 0, "maximum": 64 },
        "colSpan": { "type": "integer", "minimum": 1, "maximum": 64 },
        "rowSpan": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    }
  }
}
